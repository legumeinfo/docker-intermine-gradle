# glycinemine needs larger heap size; e.g., -Xmx16g
GRADLE_OPTS='-Xmx8g -Xms1g -server -XX:+UseParallelGC -XX:SoftRefLRUPolicyMSPerMB=1 -XX:MaxHeapFreeRatio=99 -Dorg.gradle.daemon=false'
MINE_NAME=minimine
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
POSTGRES_USER="${PGUSER}"
POSTGRES_PASSWORD="${PGPASSWORD}"
SOLR_HOST=localhost:8983
TOMCAT_HOST_PORT=localhost:8080
TOMCAT_USER=tomcat
TOMCAT_PWD=tomcat
