# glycinemine needs larger heap size; e.g., -Xmx16g
GRADLE_OPTS='-Xmx8g -Xms1g -server -XX:+UseParallelGC -XX:SoftRefLRUPolicyMSPerMB=1 -XX:MaxHeapFreeRatio=99 -Dorg.gradle.daemon=false'
JAVA_OPTS='-Xmx2g -Xms1g -Dorg.apache.el.parser.SKIP_IDENTIFIER_CHECK=true -XX:+UseParallelGC -XX:SoftRefLRUPolicyMSPerMB=1 -XX:MaxHeapFreeRatio=99'
MINE_NAME=minimine
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
POSTGRES_USER="${PGUSER}"
POSTGRES_PASSWORD="${PGPASSWORD}"
SOLR_HOST=localhost:8983
TOMCAT_HOST_PORT=127.0.0.1:8080
TOMCAT_USER=tomcat
TOMCAT_PWD=tomcat
